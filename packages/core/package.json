    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "age-encryption": "^0.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
