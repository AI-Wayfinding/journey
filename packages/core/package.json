{
  "name": "@ai-wayfinding/core",
  "version": "0.1.7",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "node ../../scripts/copy-core-rules.mjs && tsc --noEmit",
    "build": "node ../../scripts/copy-core-rules.mjs && tsc",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "age-encryption": "^0.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-Wayfinding/journey.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
