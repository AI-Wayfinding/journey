{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wayfinding-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "16c42d94e589cc74c99aed7d51687cbc",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "poc.wayfinding.support", "custom_domain": true }],
  "vars": {
    "AUTHKIT_ISSUER": "https://welcoming-folk-53-staging.authkit.app",
    "MCP_RESOURCE": "https://poc.wayfinding.support/mcp",
    "AUTHKIT_AUTHORIZE_URL": "https://welcoming-folk-53-staging.authkit.app/oauth2/authorize"
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "DCR_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "wayfinding-ciphertext" }],
  "durable_objects": {
    "bindings": [
      { "name": "JOURNEYS", "class_name": "JourneyResetV1" },
      { "name": "ACCOUNTS", "class_name": "AccountsPartitionedV1" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Journey", "Accounts"] },
    { "tag": "v2", "new_sqlite_classes": ["JourneyV2", "AccountsV2"] },
    { "tag": "sealed-v1", "new_sqlite_classes": ["JourneySealedV1", "AccountsSealedV1"] },
    { "tag": "accounts-partitioned-v1", "new_sqlite_classes": ["AccountsPartitionedV1"] },
    {
      "tag": "prototype-reset-phase1",
      "new_sqlite_classes": ["JourneyResetV1"],
      "deleted_classes": ["Journey", "Accounts", "JourneyV2", "AccountsV2", "AccountsSealedV1"]
    },
    { "tag": "prototype-reset-phase2", "deleted_classes": ["JourneySealedV1"] }
  ]
}
