{
  "name": "@ai-wayfinding/client",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wayfinding": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/integration.test.ts",
    "test:mcp": "vitest run test/integration.test.ts -t MCP"
  },
  "dependencies": {
    "@ai-wayfinding/core": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.138.0"
  }
}
